<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>locator-healing</ToolCommandName>
		<PackageId>LocatorHealing.Agent</PackageId>
		<Version>0.1.0</Version>
		<PackageOutputPath>./nupkg</PackageOutputPath>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/davespoon/locator-healing-demo</PackageProjectUrl>
		<RepositoryUrl>https://github.com/davespoon/locator-healing-demo</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Initial packaged tool metadata for CI and future publishing.</PackageReleaseNotes>

		<Authors>Grin</Authors>
		<Description>CLI worker for analyzing Selenium locator failures and proposing validated healing candidates.</Description>
		<PackageTags>selenium;testing;cli;agent;locator-healing</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.0.0-rc5" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.4.1" />
		<PackageReference Include="Microsoft.Agents.AI.Workflows.Generators" Version="1.0.0-rc5">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="System.CommandLine" Version="2.0.5" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>