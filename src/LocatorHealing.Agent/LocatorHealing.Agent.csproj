<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>locator-healing</ToolCommandName>
		<PackageId>LocatorHealing.Agent</PackageId>
		<Version>0.1.0</Version>
		<PackageOutputPath>./nupkg</PackageOutputPath>

		<Authors>Grin</Authors>
		<Description>CLI worker for analyzing Selenium locator failures and proposing validated healing candidates.</Description>
		<PackageTags>selenium;testing;cli;agent;locator-healing</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.0.0-rc4" />
		<PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-rc4" />
		<PackageReference Include="Microsoft.Agents.AI.Workflows.Generators" Version="1.0.0-rc4">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="System.CommandLine" Version="2.0.5" />
	</ItemGroup>

</Project>